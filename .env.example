# Copy to .env then adjust. Only the values below are needed to start.
# Everything else (API keys, notification channels, schedule, language...) is configured in the web interface
# (Sources, Notifications, Settings). The variables further down are optional: a value saved in the interface
# takes precedence over them.

POSTGRES_PASSWORD=change-me

# true: enables the fake demo connector (no API key needed, fictional leaks)
OPENDLM_DEMO=false

# Optional master key used to encrypt secrets stored in the database. If empty, a key file is generated in the
# /data volume on first start. Back it up: without it, saved API keys and channel URLs cannot be decrypted.
OPENDLM_SECRET_KEY=

# true if the application is served over HTTPS behind a reverse proxy
OPENDLM_COOKIE_SECURE=false

# Behind a reverse proxy: its address or network (comma-separated IPs/CIDRs), so that failed-login limits
# apply to the real client and not to the proxy. Example for the Docker network: 172.16.0.0/12
OPENDLM_TRUSTED_PROXIES=

# Two-factor authentication policy: off | admins | all (default: admins). Also editable in Settings.
OPENDLM_REQUIRE_2FA=admins

# --- Optional defaults (can be overridden in the interface) -----------------------------------------------------
OPENDLM_LANGUAGE=en
OPENDLM_TIMEZONE=Europe/Paris
OPENDLM_HIBP_API_KEY=
OPENDLM_HUDSON_ROCK_KEY=
OPENDLM_RANSOMWARE_LIVE_KEY=
# Comma-separated Apprise URLs (Discord, ntfy, mailto, Matrix...)
OPENDLM_NOTIFY_URLS=

# Push monitor called every minute (Uptime Kuma "Push" monitor, Healthchecks.io...). Also settable in Notifications.
OPENDLM_HEARTBEAT_URL=
OPENDLM_SCAN_HOUR=6
OPENDLM_REPORT_DAILY=true
OPENDLM_REPORT_MONTHLY=true
OPENDLM_REPORT_HOUR=7
OPENDLM_REPORT_SEND_EMPTY=true
OPENDLM_ALERT_MIN_SEVERITY=low
OPENDLM_NEWS_INTERVAL_MINUTES=30
OPENDLM_NEWS_RETENTION_DAYS=90
# Scan history and archived reports, and the audit trail, purged nightly (0 = keep). Leaks are never purged.
OPENDLM_HISTORY_RETENTION_DAYS=400
OPENDLM_AUDIT_RETENTION_DAYS=365
OPENDLM_ALLOW_PRIVATE_FEEDS=false
