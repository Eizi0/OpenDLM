# Copier en .env puis adapter.
POSTGRES_PASSWORD=change-me

# true : connecteur de démonstration (aucune clé nécessaire, données fictives)
OPENDLM_DEMO=false

# Clé API Have I Been Pwned (plan payant, domaine à vérifier sur le tableau de bord HIBP)
OPENDLM_HIBP_API_KEY=

# URLs Apprise séparées par des virgules (Discord, ntfy, mailto, Matrix...)
# Exemple : discord://webhook_id/webhook_token,ntfy://ntfy.sh/mon-sujet
OPENDLM_NOTIFY_URLS=

# Clé API Hudson Rock (Cavalier v3) : comptes volés par des logiciels espions.
# Le plan doit inclure la permission « search-by-domain ».
OPENDLM_HUDSON_ROCK_KEY=

# Clé API PRO ransomware.live (gratuite, usage professionnel autorisé) : revendications de rançongiciel
OPENDLM_RANSOMWARE_LIVE_KEY=

# Fréquence de lecture des sources d'actus (minutes) et durée de conservation (jours)
OPENDLM_NEWS_INTERVAL_MINUTES=30
OPENDLM_NEWS_RETENTION_DAYS=90

# true : autorise des flux RSS hébergés sur votre réseau interne (refusé par défaut)
OPENDLM_ALLOW_PRIVATE_FEEDS=false

# Rapports : quotidien (chaque jour) et mensuel (le 1er, pour le mois précédent), à l'heure indiquée
OPENDLM_REPORT_DAILY=true
OPENDLM_REPORT_MONTHLY=true
OPENDLM_REPORT_HOUR=7
# true : envoie aussi un rapport « rien à signaler » (sert de signal de vie)
OPENDLM_REPORT_SEND_EMPTY=true

# Seuil des alertes immédiates : low (toutes), high (élevées et critiques), critical (critiques seulement).
# Les fuites sous le seuil figurent dans le rapport.
OPENDLM_ALERT_MIN_SEVERITY=low

OPENDLM_SCAN_HOUR=6
OPENDLM_TIMEZONE=Europe/Paris

# true si l'application est servie en HTTPS derrière un proxy
OPENDLM_COOKIE_SECURE=false
