# Copier en .env puis adapter.
POSTGRES_PASSWORD=change-me

# true : connecteur de démonstration (aucune clé nécessaire, données fictives)
OPENDLM_DEMO=false

# Clé API Have I Been Pwned (plan payant, domaine à vérifier sur le tableau de bord HIBP)
OPENDLM_HIBP_API_KEY=

# URLs Apprise séparées par des virgules (Discord, ntfy, mailto, Matrix...)
# Exemple : discord://webhook_id/webhook_token,ntfy://ntfy.sh/mon-sujet
OPENDLM_NOTIFY_URLS=

OPENDLM_SCAN_HOUR=6
OPENDLM_TIMEZONE=Europe/Paris

# true si l'application est servie en HTTPS derrière un proxy
OPENDLM_COOKIE_SECURE=false
